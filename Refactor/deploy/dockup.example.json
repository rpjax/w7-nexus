{
  "dev": {
    "namespace": "websete",
    "network": "nexus-refactor-dev",
    "env": [
      { "name": "FRONTEND_HOST", "value": "nexus.websete.localhost" },
      { "name": "BACKEND_HOST", "value": "api.nexus.websete.localhost" },
      { "name": "HTTPS_PORT", "value": "9143" },
      { "name": "API_BASE_URL", "value": "" }
    ],
    "containers": [
      {
        "id": "postgres",
        "imageRef": "postgres:17",
        "ports": [{ "host": 5434, "container": 5432 }],
        "env": [
          { "name": "POSTGRES_USER", "value": "nexus" },
          { "name": "POSTGRES_PASSWORD", "value": "nexus" },
          { "name": "POSTGRES_DB", "value": "nexus" }
        ],
        "volumes": [{ "name": "nexus-refactor-pg", "container": "/var/lib/postgresql/data" }],
        "healthcheck": {
          "test": ["CMD-SHELL", "pg_isready -U nexus -d nexus"],
          "interval": "5s",
          "timeout": "5s",
          "retries": 12
        }
      },
      {
        "id": "webserver",
        "image": "nexus-refactor-webserver",
        "context": "../Nexus.ReverseProxy",
        "dockerfile": "Dockerfile",
        "ports": [
          { "host": 9180, "container": 80 },
          { "host": 9143, "container": 443 }
        ],
        "env": [
          { "name": "FRONTEND_HOST", "value": "${FRONTEND_HOST}" },
          { "name": "BACKEND_HOST", "value": "${BACKEND_HOST}" },
          { "name": "FRONTEND_UPSTREAM", "value": "http://frontend:80" },
          { "name": "BACKEND_UPSTREAM", "value": "http://backend:8080" },
          { "name": "LETSENCRYPT_EMAIL", "value": "" }
        ],
        "volumes": [{ "name": "traefik-acme", "container": "/acme" }],
        "dependsOn": [
          { "id": "backend", "condition": "service_started" },
          { "id": "frontend", "condition": "service_started" }
        ]
      },
      {
        "id": "backend",
        "image": "nexus-refactor-backend",
        "context": "Nexus.Api",
        "dockerfile": "Dockerfile",
        "expose": [8080],
        "env": [
          { "name": "ASPNETCORE_ENVIRONMENT", "value": "Development" },
          { "name": "NEXUS_ACCOUNTS_DB_CONNECTION", "value": "Host=postgres;Port=5432;Database=nexus;Username=nexus;Password=nexus" },
          { "name": "NEXUS_ADMIN_ACCOUNT_CREATE_TOKEN", "value": "local-dev-master-key" },
          { "name": "NEXUS_SEED_ADMIN_USERNAME", "value": "admin" },
          { "name": "NEXUS_SEED_ADMIN_PASSWORD", "value": "adminadmin" },
          { "name": "NEXUS_CORS_ORIGINS", "value": "https://${FRONTEND_HOST}:${HTTPS_PORT}" }
        ],
        "volumes": [{ "name": "dataprotection", "container": "/app/DataProtection-Keys" }],
        "dependsOn": [{ "id": "postgres", "condition": "service_healthy" }]
      },
      {
        "id": "frontend",
        "image": "nexus-refactor-frontend",
        "context": "web",
        "dockerfile": "Dockerfile",
        "expose": [80],
        "buildArgs": [{ "name": "VITE_API_BASE_URL", "value": "${API_BASE_URL}" }]
      }
    ]
  },
  "prod": {
    "namespace": "websete",
    "network": "nexus-refactor",
    "env": [
      { "name": "FRONTEND_HOST", "value": "nexus.websete.org" },
      { "name": "BACKEND_HOST", "value": "api.nexus.websete.org" },
      { "name": "API_BASE_URL", "value": "" }
    ],
    "containers": [
      {
        "id": "webserver",
        "image": "nexus-refactor-webserver",
        "context": "../Nexus.ReverseProxy",
        "dockerfile": "Dockerfile",
        "ports": [
          { "host": 80, "container": 80 },
          { "host": 443, "container": 443 }
        ],
        "env": [
          { "name": "FRONTEND_HOST", "value": "${FRONTEND_HOST}" },
          { "name": "BACKEND_HOST", "value": "${BACKEND_HOST}" },
          { "name": "FRONTEND_UPSTREAM", "value": "http://frontend:80" },
          { "name": "BACKEND_UPSTREAM", "value": "http://backend:8080" },
          { "name": "LETSENCRYPT_EMAIL", "value": "admin@websete.org" }
        ],
        "volumes": [{ "name": "traefik-acme", "container": "/acme" }],
        "dependsOn": [{ "id": "backend" }, { "id": "frontend" }]
      },
      {
        "id": "backend",
        "image": "nexus-refactor-backend",
        "context": "Nexus.Api",
        "dockerfile": "Dockerfile",
        "expose": [8080],
        "env": [
          { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
          { "name": "NEXUS_ACCOUNTS_DB_CONNECTION", "value": "" },
          { "name": "NEXUS_ADMIN_ACCOUNT_CREATE_TOKEN", "value": "" },
          { "name": "NEXUS_SEED_ADMIN_USERNAME", "value": "" },
          { "name": "NEXUS_SEED_ADMIN_PASSWORD", "value": "" }
        ],
        "volumes": [{ "name": "dataprotection", "container": "/app/DataProtection-Keys" }]
      },
      {
        "id": "frontend",
        "image": "nexus-refactor-frontend",
        "context": "web",
        "dockerfile": "Dockerfile",
        "expose": [80],
        "buildArgs": [{ "name": "VITE_API_BASE_URL", "value": "${API_BASE_URL}" }]
      }
    ]
  }
}
