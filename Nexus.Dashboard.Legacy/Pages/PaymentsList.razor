@page "/dashboard/payments"
@layout MainLayout
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<section class="page-header ops-page-header">
    <div>
        <h1>Pagamentos</h1>
        <p class="muted page-lead">Registros do agregado <strong>Payment</strong> no repositório — busca por ID, operação, transação no gateway, operador ou laranja.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(feedback))
{
    <p class="feedback @(feedbackIsError ? "error" : "success")">@feedback</p>
}

<section class="card ops-card">
    <div class="toolbar toolbar-tight toolbar-stack-mobile">
        <div class="field grow">
            <label for="paySearch">Buscar pagamentos</label>
            <input id="paySearch" class="nexus-input" @bind="search" @bind:event="oninput" placeholder="ID, operação, gateway tx, contas…" />
        </div>
        <div class="toolbar-actions">
            <button type="button" class="btn btn-ghost" @onclick="SearchAsync">Buscar</button>
            <button type="button" class="btn btn-ghost" @onclick="RefreshAsync">Atualizar</button>
        </div>
    </div>
    <div class="card-title-row">
        <div class="card-title-group">
            <h2 class="section-title">Lista</h2>
            <span class="post-badge">POST /api/payments/search</span>
        </div>
        <a class="btn btn-primary" href="/dashboard/payments/pix">Gerar PIX</a>
    </div>

    @if (filteredRows.Count == 0)
    {
        <EmptyState Title="Nenhum pagamento encontrado" Message="Ajuste a busca ou gere uma cobrança em Gerar PIX." />
    }
    else
    {
        <div class="table-wrap table-top-gap">
            <table class="responsive-data ops-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Operação</th>
                        <th>Gateway</th>
                        <th>Tx gateway</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th>Operador</th>
                        <th>Laranja</th>
                        <th>Criado em</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in filteredRows)
                    {
                        <tr>
                            <td data-label="ID"><span class="mono">@ShortId(row.Id)</span></td>
                            <td data-label="Operação"><span class="mono">@ShortId(row.OperationId)</span></td>
                            <td data-label="Gateway">@row.Gateway</td>
                            <td data-label="Tx gateway"><span class="mono token-mask" title="@row.GatewayTransactionId">@ShortTx(row.GatewayTransactionId)</span></td>
                            <td data-label="Valor">@row.Amount.ToString("N2")</td>
                            <td data-label="Status">@row.Status</td>
                            <td data-label="Operador" class="muted">@FormatOpt(row.OperatorAccountId)</td>
                            <td data-label="Laranja" class="muted">@FormatOpt(row.StrawManAccountId)</td>
                            <td data-label="Criado em" class="muted small">@row.CreatedAt.ToString("u")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);

    private sealed class PaymentRowVm
    {
        public string Id { get; set; } = string.Empty;
        public string OperationId { get; set; } = string.Empty;
        public string Gateway { get; set; } = string.Empty;
        public string GatewayTransactionId { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? OperatorAccountId { get; set; }
        public string? StrawManAccountId { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private sealed class SearchResponse
    {
        public int Total { get; set; }
        public List<PaymentRowVm> Items { get; set; } = new();
    }

    private string search = string.Empty;
    private List<PaymentRowVm> rows = new();
    private IReadOnlyList<PaymentRowVm> filteredRows = Array.Empty<PaymentRowVm>();
    private string feedback = string.Empty;
    private bool feedbackIsError;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private static string ShortId(string id)
        => string.IsNullOrEmpty(id) ? "—" : (id.Length <= 14 ? id : id[..12] + "…");

    private static string ShortTx(string tx)
    {
        if (string.IsNullOrEmpty(tx)) return "—";
        return tx.Length <= 16 ? tx : $"{tx[..8]}…{tx[^6..]}";
    }

    private static string FormatOpt(string? id)
        => string.IsNullOrWhiteSpace(id) ? "—" : ShortId(id);

    private async Task RefreshAsync()
    {
        feedback = string.Empty;
        feedbackIsError = false;
        var response = await Http.PostAsJsonAsync("/api/payments/search", new
        {
            Limit = 500,
            Offset = 0,
            Keyword = (string?)null
        });
        if (!response.IsSuccessStatusCode)
        {
            feedbackIsError = true;
            feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao carregar pagamentos.");
            rows = new List<PaymentRowVm>();
            ApplyFilter();
            return;
        }

        var data = await response.Content.ReadFromJsonAsync<SearchResponse>(_jsonOptions);
        rows = data?.Items ?? new List<PaymentRowVm>();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            filteredRows = rows;
            return;
        }

        var term = search.Trim().ToLowerInvariant();
        filteredRows = rows
            .Where(r =>
                r.Id.ToLowerInvariant().Contains(term)
                || r.OperationId.ToLowerInvariant().Contains(term)
                || r.GatewayTransactionId.ToLowerInvariant().Contains(term)
                || r.Gateway.ToLowerInvariant().Contains(term)
                || r.Status.ToLowerInvariant().Contains(term)
                || (r.OperatorAccountId != null && r.OperatorAccountId.ToLowerInvariant().Contains(term))
                || (r.StrawManAccountId != null && r.StrawManAccountId.ToLowerInvariant().Contains(term)))
            .ToList();
    }

    private Task SearchAsync()
    {
        ApplyFilter();
        return Task.CompletedTask;
    }
}
