@using System.Net.Http.Json
@using Nexus.Dashboard.Http
@inject HttpClient Http

@if (IsOpen)
{
    <div class="dialog-backdrop dialog-backdrop--picker account-picker-backdrop" @onclick="BackdropClose">
        <div class="dialog-card account-picker" @onclick:stopPropagation="true">
            <div class="account-picker-header">
                <div>
                    <h3 class="account-picker-title">@Title</h3>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <p class="account-picker-sub muted">@Subtitle</p>
                    }
                </div>
                <button type="button" class="btn btn-ghost btn-small" @onclick="CloseAsync">Fechar</button>
            </div>

            <div class="toolbar account-picker-toolbar">
                <div class="field grow">
                    <label for="@SearchInputId">Pesquisar</label>
                    <input id="@SearchInputId"
                           class="nexus-input account-picker-search"
                           @bind="Keyword"
                           @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown"
                           placeholder="Nome, ID ou descrição…" />
                </div>
                <button type="button" class="btn btn-primary" @onclick="SearchAsync">Buscar</button>
            </div>

            <div class="account-picker-list" tabindex="-1">
                @if (loading)
                {
                    <p class="muted account-picker-hint">Carregando…</p>
                }
                else if (items.Count == 0)
                {
                    <p class="muted account-picker-hint">Nenhuma operação encontrada.</p>
                }
                else
                {
                    @foreach (var row in items)
                    {
                        var disabled = IsDisabled(row.Id);
                        <button type="button"
                                class="account-picker-row @(disabled ? "is-disabled" : "")"
                                disabled="@disabled"
                                @onclick="() => PickAsync(row)">
                            <span class="account-picker-meta">
                                <span class="account-picker-name">@row.Name</span>
                                <span class="account-picker-id">@row.Id</span>
                            </span>
                            @if (disabled)
                            {
                                <span class="account-picker-badge">@DisabledBadgeText</span>
                            }
                        </button>
                    }
                }
            </div>

            <div class="pagination account-picker-pagination">
                <button type="button" class="btn btn-ghost" @onclick="PrevPageAsync" disabled="@(CurrentPage <= 1 || loading)">Anterior</button>
                <span class="muted">Página @CurrentPage de @TotalPages</span>
                <button type="button" class="btn btn-ghost" @onclick="NextPageAsync" disabled="@(CurrentPage >= TotalPages || loading)">Próxima</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly string SearchInputId = $"op-search-{Guid.NewGuid():N}";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Selecionar operação";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public IReadOnlySet<string>? DisabledOperationIds { get; set; }
    [Parameter] public string DisabledBadgeText { get; set; } = "Indisponível";

    [Parameter] public EventCallback<OperationPickerRow> OnSelected { get; set; }

    public sealed class OperationPickerRow
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private sealed class OperationSearchItemVm
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }

    private sealed class SearchResponse
    {
        public int Total { get; set; }
        public List<OperationSearchItemVm> Items { get; set; } = new();
    }

    private string Keyword { get; set; } = string.Empty;
    private int CurrentPage { get; set; } = 1;
    private const int PageSize = 8;
    private int TotalItems { get; set; }
    private int TotalPages => TotalItems == 0 ? 1 : (int)Math.Ceiling(TotalItems / (double)PageSize);

    private readonly List<OperationPickerRow> items = new();
    private bool loading;

    private bool _prevOpen;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_prevOpen)
        {
            CurrentPage = 1;
            Keyword = string.Empty;
            await LoadAsync();
        }
        _prevOpen = IsOpen;
    }

    private bool IsDisabled(string id)
        => DisabledOperationIds is not null && DisabledOperationIds.Contains(id);

    private async Task SearchAsync()
    {
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task PrevPageAsync()
    {
        if (CurrentPage <= 1)
            return;
        CurrentPage--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (CurrentPage >= TotalPages)
            return;
        CurrentPage++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsJsonAsync("/api/operations/search", new
            {
                Limit = PageSize,
                Offset = (CurrentPage - 1) * PageSize,
                Keyword = string.IsNullOrWhiteSpace(Keyword) ? null : Keyword.Trim()
            });

            if (!response.IsSuccessStatusCode)
            {
                items.Clear();
                TotalItems = 0;
                return;
            }

            var data = await DashboardApiErrors.ReadJsonAsync<SearchResponse>(response);
            TotalItems = data?.Total ?? 0;
            items.Clear();
            if (data?.Items is { Count: > 0 })
            {
                foreach (var it in data.Items)
                {
                    items.Add(new OperationPickerRow
                    {
                        Id = it.Id,
                        Name = string.IsNullOrWhiteSpace(it.Name) ? it.Id : it.Name
                    });
                }
            }
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PickAsync(OperationPickerRow row)
    {
        if (IsDisabled(row.Id))
            return;
        await OnSelected.InvokeAsync(row);
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task BackdropClose()
    {
        await CloseAsync();
    }

    private Task CloseAsync()
        => IsOpenChanged.InvokeAsync(false);
}
