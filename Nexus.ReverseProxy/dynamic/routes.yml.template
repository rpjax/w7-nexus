http:
  routers:
    frontend:
      rule: "Host(`${FRONTEND_HOST}`)"
      service: frontend
      entryPoints:
        - websecure
      tls: ${TLS_BLOCK}

    frontend-api:
      rule: "Host(`${FRONTEND_HOST}`) && PathPrefix(`/api`)"
      service: backend
      priority: 100
      entryPoints:
        - websecure
      tls: ${TLS_BLOCK}

    backend:
      rule: "Host(`${BACKEND_HOST}`)"
      service: backend
      entryPoints:
        - websecure
      tls: ${TLS_BLOCK}

  services:
    frontend:
      loadBalancer:
        servers:
          - url: "${FRONTEND_UPSTREAM}"

    backend:
      loadBalancer:
        servers:
          - url: "${BACKEND_UPSTREAM}"
