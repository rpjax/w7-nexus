@page "/dashboard"
@layout MainLayout
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<section class="page-header">
    <h1>Visão geral</h1>
    <p>Visibilidade operacional e acesso rápido aos módulos críticos do Nexus.</p>
</section>

<section class="stats-grid">
    <StatCard Label="Operações registradas" Value="@operationsTotal.ToString()" Caption="Total no repositório" Tone="info" />
    <StatCard Label="Credencial Frendz" Value="@credentialStatus" Caption="@credentialCaption" Tone="@credentialTone" />
    <StatCard Label="Credencial SigiloPay" Value="@sigiloPayCredentialStatus" Caption="@sigiloPayCredentialCaption" Tone="@sigiloPayCredentialTone" />
    <StatCard Label="Ambiente" Value="Interno" Caption="Painel sem autenticação (uso interno)" Tone="warn" />
</section>

<section class="card">
    <h2>Atalhos</h2>
    <div class="quick-actions">
        <a class="quick-action" href="/dashboard/operations">Nova operação</a>
        <a class="quick-action" href="/dashboard/payments">Gerar cobrança PIX</a>
        <a class="quick-action" href="/dashboard/gateways/frendz">Credenciais Frendz</a>
        <a class="quick-action" href="/dashboard/gateways/sigilopay">Credenciais SigiloPay</a>
    </div>
</section>

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);
    private int operationsTotal;
    private string credentialStatus = "Verificando...";
    private string credentialCaption = "Cadastradas vs habilitadas para cobrança";
    private string credentialTone = "info";
    private string sigiloPayCredentialStatus = "Verificando...";
    private string sigiloPayCredentialCaption = "Cadastradas vs habilitadas para cobrança";
    private string sigiloPayCredentialTone = "info";

    private sealed class SearchResponse<TItem>
    {
        public int Total { get; set; }
        public List<TItem> Items { get; set; } = new();
    }

    private sealed class CredentialVm
    {
        public string Id { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var operationsResponse = await Http.PostAsJsonAsync("/api/operations/search", new { Limit = 1, Offset = 0, Keyword = (string?)null });
        if (operationsResponse.IsSuccessStatusCode)
        {
            var operations = await operationsResponse.Content.ReadFromJsonAsync<SearchResponse<object>>(_jsonOptions);
            operationsTotal = operations?.Total ?? 0;
        }

        var frendzTotalResponse = await Http.PostAsJsonAsync("/api/frendz/search", new { Limit = 1, Offset = 0, Keyword = (string?)null });
        var frendzEnabledResponse = await Http.PostAsJsonAsync("/api/frendz/search", new { Limit = 1, Offset = 0, Keyword = (string?)null, enabledOnly = true });
        if (frendzTotalResponse.IsSuccessStatusCode && frendzEnabledResponse.IsSuccessStatusCode)
        {
            var totalData = await frendzTotalResponse.Content.ReadFromJsonAsync<SearchResponse<CredentialVm>>(_jsonOptions);
            var enabledData = await frendzEnabledResponse.Content.ReadFromJsonAsync<SearchResponse<CredentialVm>>(_jsonOptions);
            var total = totalData?.Total ?? 0;
            var enabled = enabledData?.Total ?? 0;
            credentialCaption = total == 0 ? "Nenhuma credencial cadastrada" : $"{enabled} habilitada(s) de {total} cadastrada(s)";
            if (total == 0)
            {
                credentialStatus = "Ausente";
                credentialTone = "danger";
            }
            else if (enabled == 0)
            {
                credentialStatus = "Desativadas";
                credentialTone = "warn";
            }
            else
            {
                credentialStatus = "Pronto";
                credentialTone = "success";
            }
        }
        else
        {
            credentialStatus = "Verificando...";
            credentialCaption = "Cadastradas vs habilitadas para cobrança";
            credentialTone = "info";
        }

        var spTotalResponse = await Http.PostAsJsonAsync("/api/sigilopay/search", new { Limit = 1, Offset = 0, Keyword = (string?)null });
        var spEnabledResponse = await Http.PostAsJsonAsync("/api/sigilopay/search", new { Limit = 1, Offset = 0, Keyword = (string?)null, enabledOnly = true });
        if (spTotalResponse.IsSuccessStatusCode && spEnabledResponse.IsSuccessStatusCode)
        {
            var totalSp = await spTotalResponse.Content.ReadFromJsonAsync<SearchResponse<CredentialVm>>(_jsonOptions);
            var enabledSp = await spEnabledResponse.Content.ReadFromJsonAsync<SearchResponse<CredentialVm>>(_jsonOptions);
            var total = totalSp?.Total ?? 0;
            var enabled = enabledSp?.Total ?? 0;
            sigiloPayCredentialCaption = total == 0 ? "Nenhuma credencial cadastrada" : $"{enabled} habilitada(s) de {total} cadastrada(s)";
            if (total == 0)
            {
                sigiloPayCredentialStatus = "Ausente";
                sigiloPayCredentialTone = "danger";
            }
            else if (enabled == 0)
            {
                sigiloPayCredentialStatus = "Desativadas";
                sigiloPayCredentialTone = "warn";
            }
            else
            {
                sigiloPayCredentialStatus = "Pronto";
                sigiloPayCredentialTone = "success";
            }
        }
        else
        {
            sigiloPayCredentialStatus = "Verificando...";
            sigiloPayCredentialCaption = "Cadastradas vs habilitadas para cobrança";
            sigiloPayCredentialTone = "info";
        }
    }
}
