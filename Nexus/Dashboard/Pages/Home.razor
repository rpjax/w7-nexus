@page "/dashboard"
@layout MainLayout
@using Aidan.Core.Linq.Extensions
@using Nexus.Operations.Application
@using Nexus.Frendz.Application
@inject IOperationRepository OperationRepository
@inject IFrendzApiKeysService FrendzApiKeysService

<section class="page-header">
    <h1>Visão geral</h1>
    <p>Visibilidade operacional e ações rápidas dos módulos do Nexus.</p>
</section>

<section class="stats-grid">
    <StatCard Label="Operações" Value="@operationsTotal.ToString()" Caption="Operações registradas" />
    <StatCard Label="Credencial Frendz" Value="@credentialStatus" Caption="Status do gateway" />
    <StatCard Label="Ambiente" Value="Interno" Caption="Sem autenticação" />
</section>

@code {
    private int operationsTotal;
    private string credentialStatus = "Verificando...";

    protected override async Task OnInitializedAsync()
    {
        operationsTotal = await OperationRepository.AsQueryable().CountAsync();
        var credential = await FrendzApiKeysService.GetRandomCredentialsAsync();
        credentialStatus = credential is null ? "Ausente" : "Configurado";
    }
}
