@page "/dashboard/operations"
@layout MainLayout
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@inject HttpClient Http

<section class="page-header ops-page-header">
    <div>
        <h1>Gestão de operações</h1>
        <p class="muted page-lead">Configure fluxos de trabalho, operadores e laranjas vinculados por conta.</p>
    </div>
</section>

<section class="card ops-card ops-create">
    <div class="card-title-row">
        <h2>Criar nova operação</h2>
        <span class="post-badge" title="Endpoint">POST /api/operations</span>
    </div>
    <div class="form-grid">
        <div class="field">
            <label for="opName">Nome da operação</label>
            <input id="opName" class="nexus-input" @bind="createModel.Name" @bind:event="oninput" placeholder="Ex.: Gateway Phoenix" />
        </div>
        <div class="field span-2">
            <label for="opDesc">Descrição</label>
            <textarea id="opDesc" class="nexus-input" rows="2" @bind="createModel.Description" @bind:event="oninput" placeholder="Contexto e escopo da operação"></textarea>
        </div>
        <div class="field span-2">
            <label>Operadores iniciais <span class="muted small">opcional</span></label>
            <div class="chips-wrap">
                @foreach (var id in createInitialOperatorIds)
                {
                    <span class="chip">
                        @LabelFor(id)
                        <button type="button" class="chip-remove" @onclick="() => RemoveInitialOperator(id)" aria-label="Remover">×</button>
                    </span>
                }
                <button type="button" class="btn btn-ghost btn-small" @onclick="() => initialPickerOpen = true">
                    + Adicionar conta
                </button>
            </div>
        </div>
    </div>
    <div class="card-actions">
        <button type="button" class="btn btn-primary" @onclick="CreateAsync" disabled="@createBusy">
            @(createBusy ? "Registrando…" : "Registrar operação")
        </button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(feedback))
{
    <p class="feedback @(feedbackIsError ? "error" : "success")">@feedback</p>
}

@if (manageModalOpen && manageOperation is not null)
{
    <div class="dialog-backdrop dialog-backdrop--modal" @onclick="CloseManageModal">
        <div class="dialog-card dialog-card--wide dialog-card--manage-op" @onclick:stopPropagation="true">
            <div class="modal-stack">
                <div class="modal-stack-header">
                    <div>
                        <h2 class="manage-ids-title">Gerenciar operação</h2>
                        <p class="muted manage-ids-desc">
                            <strong>@manageOperation.Name</strong>
                            <span class="mono"> · @manageOperation.Id</span>
                        </p>
                    </div>
                    <button type="button" class="btn btn-ghost btn-small" @onclick="CloseManageModal">Fechar</button>
                </div>

                <div class="dual-grid manage-ids-grid">
                    <div class="mini-card manage-link">
                        <div class="manage-link-label">
                            <span>Vincular operador</span>
                            <span class="post-badge small">POST</span>
                        </div>
                        <div class="account-select-row">
                            <button type="button" class="account-select-trigger" @onclick="() => operatorPickerOpen = true">
                                @(string.IsNullOrWhiteSpace(operatorPickPreview) ? "Selecionar conta" : operatorPickPreview)
                            </button>
                            <button type="button" class="btn-icon btn-icon-green" @onclick="() => operatorPickerOpen = true" title="Selecionar operador">＋</button>
                        </div>
                    </div>
                    <div class="mini-card manage-link">
                        <div class="manage-link-label">
                            <span>Vincular laranja</span>
                            <span class="post-badge small post-badge-warm">POST</span>
                        </div>
                        <div class="account-select-row">
                            <button type="button" class="account-select-trigger" @onclick="() => strawPickerOpen = true">
                                @(string.IsNullOrWhiteSpace(strawPickPreview) ? "Selecionar conta" : strawPickPreview)
                            </button>
                            <button type="button" class="btn-icon btn-icon-warm" @onclick="() => strawPickerOpen = true" title="Selecionar laranja">＋</button>
                        </div>
                    </div>
                </div>

                <div class="dual-grid">
                    <section class="mini-card">
                        <h3>Operadores</h3>
                        @if (manageOperation.OperatorIds.Count == 0)
                        {
                            <p class="muted">Nenhum operador vinculado.</p>
                        }
                        else
                        {
                            <ul class="chip-list">
                                @foreach (var id in manageOperation.OperatorIds)
                                {
                                    <li>
                                        <span>@LabelFor(id)</span>
                                        <button type="button" class="btn btn-danger btn-small" @onclick="() => RemoveOperatorAsync(id)">Remover</button>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                    <section class="mini-card">
                        <h3>Laranjas</h3>
                        @if (manageOperation.StrawManIds.Count == 0)
                        {
                            <p class="muted">Nenhum laranja vinculado.</p>
                        }
                        else
                        {
                            <ul class="chip-list">
                                @foreach (var id in manageOperation.StrawManIds)
                                {
                                    <li>
                                        <span>@LabelFor(id)</span>
                                        <button type="button" class="btn btn-danger btn-small" @onclick="() => RemoveStrawManAsync(id)">Remover</button>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
}

<section class="card ops-card">
    <div class="toolbar">
        <div class="field grow">
            <label for="opSearch">Buscar operações</label>
            <input id="opSearch" class="nexus-input" @bind="search" @bind:event="oninput" placeholder="Nome, ID ou descrição…" />
        </div>
        <button type="button" class="btn btn-ghost" @onclick="SearchAsync">Buscar</button>
        <button type="button" class="btn btn-ghost" @onclick="RefreshAsync">Atualizar</button>
    </div>

    @if (items.Length == 0)
    {
        <EmptyState Title="Nenhuma operação encontrada" Message="Crie uma operação acima ou ajuste o filtro." />
    }
    else
    {
        <div class="table-wrap">
            <table class="responsive-data ops-table ops-table-desktop">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Operadores</th>
                        <th>Laranjas</th>
                        <th>Atualizado</th>
                        <th class="th-actions" scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in items)
                    {
                        <tr class="@RowSelectedClass(op.Id)">
                            <td data-label="Nome">
                                <div class="cell-title">@op.Name</div>
                                <div class="cell-sub mono">@op.Id</div>
                            </td>
                            <td data-label="Descrição">@(string.IsNullOrWhiteSpace(op.Description) ? "—" : op.Description)</td>
                            <td data-label="Operadores"><span class="count-pill">@op.OperatorIds.Count</span></td>
                            <td data-label="Laranjas"><span class="count-pill count-pill-warm">@op.StrawManIds.Count</span></td>
                            <td data-label="Atualizado" class="muted">@op.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="cell-actions" data-label="Ações">
                                <div class="row-actions">
                                    <button type="button"
                                            class="icon-action"
                                            title="Gerenciar"
                                            aria-label="Gerenciar operação"
                                            @onclick="() => OpenManageModal(op.Id)">
                                        ✎
                                    </button>
                                    <button type="button"
                                            class="icon-action icon-action-danger"
                                            title="Excluir"
                                            aria-label="Excluir operação"
                                            @onclick="() => PromptDelete(op.Id)">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalItems > 0)
        {
            <div class="pagination">
                <button type="button" class="btn btn-ghost" @onclick="PrevPage" disabled="@(currentPage <= 1)">Anterior</button>
                <span class="muted">Página @currentPage de @totalPages</span>
                <button type="button" class="btn btn-ghost" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Próxima</button>
            </div>
        }
    }
</section>

<AccountPickerModal @bind-IsOpen="initialPickerOpen"
                    Title="Operadores iniciais"
                    Subtitle="Contas elegíveis para compor a operação ao criar."
                    DisabledAccountIds="InitialDisabledSet"
                    OnSelected="OnInitialAccountPicked" />

<AccountPickerModal @bind-IsOpen="operatorPickerOpen"
                    Title="Vincular operador"
                    Subtitle="A mesma conta pode ser operador e laranja; aqui só contam IDs já como operador."
                    DisabledBadgeText="Já é operador"
                    DisabledAccountIds="OperatorPickerDisabledSet"
                    OnSelected="OnOperatorAccountPicked" />

<AccountPickerModal @bind-IsOpen="strawPickerOpen"
                    Title="Vincular laranja"
                    Subtitle="A mesma conta pode ser operador e laranja; aqui só contam IDs já como laranja."
                    DisabledBadgeText="Já é laranja"
                    DisabledAccountIds="StrawPickerDisabledSet"
                    OnSelected="OnStrawAccountPicked" />

<ConfirmDialog IsOpen="@deleteDialogOpen"
                Title="Confirmar exclusão"
                Message="Tem certeza que deseja excluir esta operação?"
                OnCancel="CancelDelete"
                OnConfirm="ConfirmDeleteAsync" />

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);

    private sealed class CreateOperationVm
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    private sealed class OperationVm
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public List<string> OperatorIds { get; set; } = new();
        public List<string> StrawManIds { get; set; } = new();
        public DateTime UpdatedAt { get; set; }
    }

    private sealed class SearchResponse<TItem>
    {
        public int Total { get; set; }
        public List<TItem> Items { get; set; } = new();
    }

    private readonly CreateOperationVm createModel = new();
    private readonly List<string> createInitialOperatorIds = new();
    private readonly Dictionary<string, string> accountLabels = new(StringComparer.Ordinal);

    private string search = string.Empty;
    private string feedback = string.Empty;
    private bool feedbackIsError;
    private OperationVm[] items = Array.Empty<OperationVm>();

    private int currentPage = 1;
    private int pageSize = 20;
    private int totalItems;
    private int totalPages => totalItems == 0 ? 1 : (int)Math.Ceiling(totalItems / (double)pageSize);

    private bool deleteDialogOpen;
    private string deleteOperationId = string.Empty;

    private bool manageModalOpen;
    private OperationVm? manageOperation;

    private bool initialPickerOpen;
    private bool operatorPickerOpen;
    private bool strawPickerOpen;
    private bool createBusy;

    private string operatorPickPreview = string.Empty;
    private string strawPickPreview = string.Empty;

    private HashSet<string> InitialDisabledSet => new(createInitialOperatorIds, StringComparer.Ordinal);

    private HashSet<string>? OperatorPickerDisabledSet =>
        manageOperation is null
            ? null
            : new HashSet<string>(manageOperation.OperatorIds, StringComparer.Ordinal);

    private HashSet<string>? StrawPickerDisabledSet =>
        manageOperation is null
            ? null
            : new HashSet<string>(manageOperation.StrawManIds, StringComparer.Ordinal);

    private string? RowSelectedClass(string opId)
        => manageModalOpen && manageOperation?.Id == opId ? "is-selected" : null;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var payload = new
        {
            Limit = pageSize,
            Offset = (currentPage - 1) * pageSize,
            Keyword = string.IsNullOrWhiteSpace(search) ? null : search.Trim()
        };

        var response = await Http.PostAsJsonAsync("/api/operations/search", payload);
        if (!response.IsSuccessStatusCode)
        {
            feedbackIsError = true;
            feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao carregar operações.");
            return;
        }

        var data = await response.Content.ReadFromJsonAsync<SearchResponse<OperationVm>>(_jsonOptions);
        totalItems = data?.Total ?? 0;
        items = data?.Items?.ToArray() ?? Array.Empty<OperationVm>();

        if (manageModalOpen && manageOperation is not null)
        {
            var updated = items.FirstOrDefault(o => o.Id == manageOperation.Id);
            if (updated is not null)
            {
                manageOperation = updated;
                SyncLabelsFromOperation(manageOperation);
            }
        }
    }

    private void SyncLabelsFromOperation(OperationVm op)
    {
        foreach (var id in op.OperatorIds.Concat(op.StrawManIds))
            accountLabels.TryAdd(id, ShortId(id));
    }

    private static string ShortId(string id)
        => id.Length <= 12 ? id : id[..8] + "…";

    private string LabelFor(string id)
        => accountLabels.TryGetValue(id, out var u) ? $"{u} · {id}" : id;

    private async Task RefreshAsync() => await LoadAsync();

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task CreateAsync()
    {
        createBusy = true;
        feedback = string.Empty;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/operations", new
            {
                Name = createModel.Name,
                Description = createModel.Description,
                Operators = createInitialOperatorIds
            });

            if (response.IsSuccessStatusCode)
            {
                feedbackIsError = false;
                feedback = "Operação criada com sucesso.";
                createModel.Name = string.Empty;
                createModel.Description = string.Empty;
                createInitialOperatorIds.Clear();
                currentPage = 1;
                await LoadAsync();
            }
            else
            {
                feedbackIsError = true;
                feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao criar operação.");
            }
        }
        finally
        {
            createBusy = false;
        }
    }

    private void RemoveInitialOperator(string id)
    {
        createInitialOperatorIds.Remove(id);
        accountLabels.Remove(id);
    }

    private Task OnInitialAccountPicked(AccountPickerModal.AccountPickerRow row)
    {
        if (createInitialOperatorIds.Contains(row.Id))
            return Task.CompletedTask;
        createInitialOperatorIds.Add(row.Id);
        accountLabels[row.Id] = row.Username;
        return Task.CompletedTask;
    }

    private async Task OnOperatorAccountPicked(AccountPickerModal.AccountPickerRow row)
    {
        operatorPickPreview = $"{row.Username} ({row.Id})";
        await AddOperatorWithIdAsync(row.Id, row.Username);
    }

    private async Task OnStrawAccountPicked(AccountPickerModal.AccountPickerRow row)
    {
        strawPickPreview = $"{row.Username} ({row.Id})";
        await AddStrawManWithIdAsync(row.Id, row.Username);
    }

    private void PromptDelete(string operationId)
    {
        deleteOperationId = operationId;
        deleteDialogOpen = true;
    }

    private void CancelDelete()
    {
        deleteDialogOpen = false;
        deleteOperationId = string.Empty;
    }

    private async Task ConfirmDeleteAsync()
    {
        deleteDialogOpen = false;
        if (string.IsNullOrWhiteSpace(deleteOperationId))
            return;

        var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "/api/operations/operations")
        {
            Content = CreateJsonContent(new { OperationId = deleteOperationId })
        });

        if (response.IsSuccessStatusCode)
        {
            feedbackIsError = false;
            feedback = "Operação excluída com sucesso.";
            if (manageOperation?.Id == deleteOperationId)
                CloseManageModal();
            deleteOperationId = string.Empty;
            currentPage = 1;
            await LoadAsync();
        }
        else
        {
            feedbackIsError = true;
            feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao excluir operação.");
        }
    }

    private async Task PrevPage()
    {
        if (currentPage <= 1)
            return;
        currentPage--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages)
            return;
        currentPage++;
        await LoadAsync();
    }

    private void OpenManageModal(string operationId)
    {
        manageOperation = items.FirstOrDefault(o => o.Id == operationId);
        if (manageOperation is null)
            return;
        manageModalOpen = true;
        operatorPickPreview = string.Empty;
        strawPickPreview = string.Empty;
        SyncLabelsFromOperation(manageOperation);
    }

    private void CloseManageModal()
    {
        manageModalOpen = false;
        manageOperation = null;
        operatorPickPreview = string.Empty;
        strawPickPreview = string.Empty;
    }

    private async Task AddOperatorWithIdAsync(string accountId, string username)
    {
        if (manageOperation is null)
            return;

        accountLabels[accountId] = username;
        var response = await Http.PostAsJsonAsync("/api/operations/operators", new
        {
            OperationId = manageOperation.Id,
            OperatorId = accountId
        });
        feedbackIsError = !response.IsSuccessStatusCode;
        feedback = response.IsSuccessStatusCode
            ? $"Operador vinculado à operação {manageOperation.Id}."
            : await DashboardApiErrors.ReadMessageAsync(response, "Falha ao adicionar operador.");
        await LoadAsync();
    }

    private async Task RemoveOperatorAsync(string accountId)
    {
        if (manageOperation is null)
            return;

        var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "/api/operations/operators")
        {
            Content = CreateJsonContent(new { OperationId = manageOperation.Id, OperatorId = accountId })
        });
        feedbackIsError = !response.IsSuccessStatusCode;
        feedback = response.IsSuccessStatusCode
            ? "Operador removido com sucesso."
            : await DashboardApiErrors.ReadMessageAsync(response, "Falha ao remover operador.");
        await LoadAsync();
    }

    private async Task AddStrawManWithIdAsync(string accountId, string username)
    {
        if (manageOperation is null)
            return;

        accountLabels[accountId] = username;
        var response = await Http.PostAsJsonAsync("/api/operations/strawman", new
        {
            OperationId = manageOperation.Id,
            StrawManId = accountId
        });
        feedbackIsError = !response.IsSuccessStatusCode;
        feedback = response.IsSuccessStatusCode
            ? $"Laranja vinculado à operação {manageOperation.Id}."
            : await DashboardApiErrors.ReadMessageAsync(response, "Falha ao adicionar laranja.");
        await LoadAsync();
    }

    private async Task RemoveStrawManAsync(string accountId)
    {
        if (manageOperation is null)
            return;

        var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "/api/operations/strawman")
        {
            Content = CreateJsonContent(new { OperationId = manageOperation.Id, StrawManId = accountId })
        });
        feedbackIsError = !response.IsSuccessStatusCode;
        feedback = response.IsSuccessStatusCode
            ? "Laranja removido com sucesso."
            : await DashboardApiErrors.ReadMessageAsync(response, "Falha ao remover laranja.");
        await LoadAsync();
    }

    private static StringContent CreateJsonContent(object payload)
        => new(JsonSerializer.Serialize(payload), Encoding.UTF8, "application/json");
}
