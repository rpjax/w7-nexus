@page "/dashboard/gateways/frendz"
@layout MainLayout
@using Nexus.Frendz.Application
@using Nexus.Frendz.Application.Models
@inject IFrendzApiKeysService FrendzApiKeysService
@inject IFrendzApiCredentialsRepository FrendzApiCredentialsRepository
@using Aidan.Core.Linq.Extensions

<section class="page-header">
    <h1>Frendz</h1>
    <p>Gerencie as credenciais de integração do gateway Frendz.</p>
</section>

@if (!string.IsNullOrWhiteSpace(feedback))
{
    <p class="feedback @(feedbackIsError ? "error" : string.Empty)">@feedback</p>
}

<section class="card">
    <h2>Adicionar credencial</h2>
    <EditForm Model="@addModel" OnValidSubmit="@AddAsync" class="form-grid" FormName="addCredentialForm">
        <div class="field">
            <label for="credName">Nome</label>
            <InputText id="credName" @bind-Value="addModel.Name" placeholder="Ex: token dev" />
        </div>
        <div class="field">
            <label for="credToken">Token</label>
            <InputText id="credToken" @bind-Value="addModel.Token" placeholder="Cole o token da Frendz" />
        </div>
        <button type="submit" class="btn btn-primary">Adicionar</button>
    </EditForm>
</section>

<section class="card">
    <div class="toolbar" style="margin-bottom: 0;">
        <div class="field" style="min-width: 260px;">
            <label for="credSearch">Buscar</label>
            <InputText id="credSearch" @bind-Value="search" placeholder="Ex: default, id, dev..." />
        </div>
        <button class="btn btn-ghost" @onclick="SearchAsync">Buscar</button>
        <button class="btn btn-ghost" @onclick="RefreshAsync">Atualizar</button>
    </div>

    <h2 style="margin-top: 1rem;">Credenciais cadastradas</h2>

    @if (filteredCredentials.Count == 0)
    {
        <EmptyState Title="Nenhuma credencial encontrada" Message="Cadastre uma credencial acima ou ajuste sua busca." />
    }
    else
    {
        <div class="table-wrap" style="margin-top: 0.75rem;">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Token</th>
                        <th style="width: 1%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cred in filteredCredentials)
                    {
                        <tr>
                            <td>@cred.Name</td>
                            <td><span title="@cred.Token">@MaskToken(cred.Token)</span></td>
                            <td>
                                <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
                                    <button class="btn btn-ghost" @onclick="() => ViewAsync(cred)">Ler</button>
                                    <button class="btn btn-ghost" @onclick="() => BeginEditAsync(cred)">Editar</button>
                                    <button class="btn btn-danger" @onclick="() => BeginDeleteAsync(cred.Id)">Excluir</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (editing is not null)
{
    <section class="card">
        <h2>Editar credencial</h2>
        <EditForm Model="@editing" OnValidSubmit="@UpdateAsync" class="form-grid" FormName="editCredentialForm">
            <div class="field">
                <label for="editCredName">Nome</label>
                <InputText id="editCredName" @bind-Value="editing.Name" />
            </div>
            <div class="field">
                <label for="editCredToken">Token</label>
                <InputText id="editCredToken" @bind-Value="editing.Token" />
            </div>
            <div style="display:flex; gap:0.6rem; align-items:center;">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <button type="button" class="btn btn-ghost" @onclick="CancelEditAsync">Cancelar</button>
            </div>
        </EditForm>
    </section>
}

<ConfirmDialog IsOpen="@deleteDialogOpen"
                Title="Confirmar exclusão"
                Message="Tem certeza que deseja excluir esta credencial?"
                OnCancel="CancelDeleteAsync"
                OnConfirm="ConfirmDeleteAsync" />

@if (viewingCredential is not null)
{
    <div class="dialog-backdrop">
        <div class="dialog-card">
            <h3>Credencial</h3>
            <p><strong>ID:</strong> @viewingCredential.Id</p>
            <p><strong>Nome:</strong> @viewingCredential.Name</p>
            <p><strong>Token:</strong></p>
            <textarea readonly rows="5">@viewingCredential.Token</textarea>
            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="CloseViewAsync">Fechar</button>
            </div>
        </div>
    </div>
}

@code {
    private class CredentialVm
    {
        public string Name { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
    }

    private sealed class EditCredentialVm : CredentialVm
    {
        public string Id { get; set; } = string.Empty;
        public string? StrawManId { get; set; }
    }

    private readonly CredentialVm addModel = new();
    private string search = string.Empty;

    private List<FrendzApiCredentials> credentials = new();
    private IReadOnlyList<FrendzApiCredentials> filteredCredentials = Array.Empty<FrendzApiCredentials>();

    private EditCredentialVm? editing;

    private bool deleteDialogOpen;
    private string deleteId = string.Empty;

    private FrendzApiCredentials? viewingCredential;

    private string feedback = string.Empty;
    private bool feedbackIsError;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        feedbackIsError = false;
        feedback = string.Empty;

        var items = await FrendzApiCredentialsRepository.AsQueryable()
            .OrderBy(c => c.Name)
            .ToArrayAsync();
        credentials = items.ToList();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            filteredCredentials = credentials;
            return;
        }

        var term = search.Trim().ToLowerInvariant();
        filteredCredentials = credentials
            .Where(c =>
                c.Name.ToLowerInvariant().Contains(term) ||
                c.Id.ToLowerInvariant().Contains(term) ||
                c.Token.ToLowerInvariant().Contains(term))
            .ToList();
    }

    private async Task SearchAsync()
    {
        ApplyFilter();
        await Task.CompletedTask;
    }

    private async Task AddAsync()
    {
        feedbackIsError = false;
        feedback = string.Empty;

        if (string.IsNullOrWhiteSpace(addModel.Token))
        {
            feedbackIsError = true;
            feedback = "O token é obrigatório.";
            return;
        }

        try
        {
            await FrendzApiKeysService.AddCredentialsAsync(null, addModel.Token, addModel.Name);
            feedback = "Credencial adicionada com sucesso.";
            addModel.Name = string.Empty;
            addModel.Token = string.Empty;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            feedbackIsError = true;
            feedback = ex.Message;
        }
    }

    private static string MaskToken(string token)
    {
        if (string.IsNullOrWhiteSpace(token))
            return string.Empty;

        if (token.Length <= 10)
            return new string('*', token.Length);

        return $"{token[..4]}...{token[^4..]}";
    }

    private void ViewAsync(FrendzApiCredentials cred)
    {
        viewingCredential = cred;
    }

    private Task CloseViewAsync()
    {
        viewingCredential = null;
        return Task.CompletedTask;
    }

    private void BeginEditAsync(FrendzApiCredentials cred)
    {
        editing = new EditCredentialVm
        {
            Id = cred.Id,
            Name = cred.Name,
            Token = cred.Token,
            StrawManId = cred.StrawManId
        };
        feedback = string.Empty;
        feedbackIsError = false;
    }

    private Task CancelEditAsync()
    {
        editing = null;
        return Task.CompletedTask;
    }

    private async Task UpdateAsync()
    {
        if (editing is null)
            return;

        feedbackIsError = false;
        feedback = string.Empty;

        if (string.IsNullOrWhiteSpace(editing.Token))
        {
            feedbackIsError = true;
            feedback = "O token é obrigatório.";
            return;
        }

        try
        {
            var updated = await FrendzApiKeysService.UpdateCredentialsAsync(
                editing.Id,
                editing.StrawManId,
                editing.Token,
                editing.Name);
            if (!updated)
            {
                feedbackIsError = true;
                feedback = "Falha ao atualizar a credencial (id inválido ou não encontrado).";
                return;
            }

            feedback = "Credencial atualizada com sucesso.";
            editing = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            feedbackIsError = true;
            feedback = ex.Message;
        }
    }

    private Task BeginDeleteAsync(string id)
    {
        deleteId = id;
        deleteDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CancelDeleteAsync()
    {
        deleteDialogOpen = false;
        deleteId = string.Empty;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        deleteDialogOpen = false;
        if (string.IsNullOrWhiteSpace(deleteId))
            return;

        feedbackIsError = false;
        feedback = string.Empty;

        try
        {
            var deleted = await FrendzApiKeysService.DeleteCredentialsAsync(deleteId);
            feedbackIsError = !deleted;
            feedback = deleted ? "Credencial excluída com sucesso." : "Credencial não encontrada.";
            deleteId = string.Empty;
            editing = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            feedbackIsError = true;
            feedback = ex.Message;
        }
    }
}
