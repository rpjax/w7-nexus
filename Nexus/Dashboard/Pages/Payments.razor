@page "/dashboard/payments"
@layout MainLayout
@using Microsoft.JSInterop
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<section class="page-header">
    <h1>Pagamentos PIX</h1>
    <p class="muted page-lead">Gere cobrança PIX vinculada a uma operação; operador e laranja são opcionais (contas).</p>
</section>

<section class="card ops-card">
    <div class="card-title-row">
        <h2>Gerar PIX</h2>
        <span class="post-badge">POST /api/charges/pix</span>
    </div>
    <div class="form-grid">
        <div class="field">
            <label for="pixOpId">ID da operação</label>
            <input id="pixOpId" class="nexus-input" @bind="model.OperationId" @bind:event="oninput" placeholder="GUID da operação" />
        </div>
        <div class="field">
            <label for="pixAmount">Valor</label>
            <InputNumber id="pixAmount" TValue="decimal" @bind-Value="model.Amount" class="nexus-input" />
        </div>
        <div class="field span-2">
            <label>Conta do operador <span class="muted small">opcional</span></label>
            <div class="account-select-row">
                <button type="button" class="account-select-trigger" @onclick="() => operatorPickerOpen = true">
                    @(operatorLabel ?? "Nenhum")
                </button>
                <button type="button" class="btn-icon btn-icon-green" @onclick="() => operatorPickerOpen = true">＋</button>
                @if (model.OperatorAccountId is not null)
                {
                    <button type="button" class="btn btn-ghost btn-small" @onclick="ClearOperator">Limpar</button>
                }
            </div>
        </div>
        <div class="field span-2">
            <label>Conta laranja <span class="muted small">opcional</span></label>
            <div class="account-select-row">
                <button type="button" class="account-select-trigger" @onclick="() => strawPickerOpen = true">
                    @(strawLabel ?? "Nenhum")
                </button>
                <button type="button" class="btn-icon btn-icon-warm" @onclick="() => strawPickerOpen = true">＋</button>
                @if (model.StrawManAccountId is not null)
                {
                    <button type="button" class="btn btn-ghost btn-small" @onclick="ClearStraw">Limpar</button>
                }
            </div>
        </div>
    </div>
    <div class="card-actions">
        <button type="button" class="btn btn-primary" @onclick="GeneratePixAsync" disabled="@generateBusy">
            @(generateBusy ? "Gerando…" : "Gerar PIX")
        </button>
    </div>
</section>

<AccountPickerModal @bind-IsOpen="operatorPickerOpen"
                    Title="Conta do operador"
                    Subtitle="Opcional — filtra a cobrança ao operador."
                    OnSelected="OnOperatorPicked" />

<AccountPickerModal @bind-IsOpen="strawPickerOpen"
                    Title="Conta laranja"
                    Subtitle="Opcional — alinha credenciais Frendz com laranja."
                    OnSelected="OnStrawPicked" />

@if (!string.IsNullOrWhiteSpace(error))
{
    <section class="feedback-block error">
        <h3>Falha ao gerar cobrança</h3>
        <p>@error</p>
    </section>
}

@if (lastResult is not null)
{
    <section class="card success-panel">
        <h3>Cobrança gerada</h3>
        <p><strong>ID do pagamento:</strong> <span class="mono">@lastResult.Id</span></p>
        <p><strong>Código PIX:</strong></p>
        <div class="copy-wrap">
            <textarea readonly rows="6" class="nexus-input">@lastResult.Code</textarea>
            <button type="button" class="btn btn-ghost" @onclick="CopyPixCodeAsync">Copiar</button>
        </div>
        @if (pixCopied)
        {
            <p class="feedback success">Código PIX copiado.</p>
        }
    </section>
}

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);

    private sealed class GeneratePixVm
    {
        public string OperationId { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string? OperatorAccountId { get; set; }
        public string? StrawManAccountId { get; set; }
    }

    private sealed class PixChargeVm
    {
        public string Id { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
    }

    private readonly GeneratePixVm model = new();
    private PixChargeVm? lastResult;
    private string error = string.Empty;
    private bool pixCopied;
    private bool generateBusy;

    private bool operatorPickerOpen;
    private bool strawPickerOpen;
    private string? operatorLabel;
    private string? strawLabel;

    private Task OnOperatorPicked(AccountPickerModal.AccountPickerRow row)
    {
        model.OperatorAccountId = row.Id;
        operatorLabel = $"{row.Username} ({row.Id})";
        return Task.CompletedTask;
    }

    private Task OnStrawPicked(AccountPickerModal.AccountPickerRow row)
    {
        model.StrawManAccountId = row.Id;
        strawLabel = $"{row.Username} ({row.Id})";
        return Task.CompletedTask;
    }

    private void ClearOperator()
    {
        model.OperatorAccountId = null;
        operatorLabel = null;
    }

    private void ClearStraw()
    {
        model.StrawManAccountId = null;
        strawLabel = null;
    }

    private async Task GeneratePixAsync()
    {
        error = string.Empty;
        lastResult = null;
        pixCopied = false;
        generateBusy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/charges/pix", new
            {
                OperationId = model.OperationId,
                Amount = model.Amount,
                OperatorAccountId = model.OperatorAccountId,
                StrawManAccountId = model.StrawManAccountId
            });

            if (!response.IsSuccessStatusCode)
            {
                error = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao gerar cobrança PIX.");
                return;
            }

            lastResult = await response.Content.ReadFromJsonAsync<PixChargeVm>(_jsonOptions);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            generateBusy = false;
        }
    }

    private async Task CopyPixCodeAsync()
    {
        if (lastResult is null || string.IsNullOrWhiteSpace(lastResult.Code))
            return;

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", lastResult.Code);
        pixCopied = true;
    }
}
