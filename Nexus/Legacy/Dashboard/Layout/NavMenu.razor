<nav class="nav-shell">
    <div class="brand-wrap">
        <div class="brand-mark" aria-hidden="true"></div>
        <div>
            <p class="brand">Websete Nexus</p>
            <p class="brand-subtitle">Operações e pagamentos</p>
        </div>
    </div>

    <div class="nav-links">
        <NavLink href="/dashboard" Match="NavLinkMatch.All">Visão geral</NavLink>
        <NavLink href="/dashboard/operations">Operações</NavLink>

        <div class="nav-group nav-group-gateways">
            <button type="button"
                    class="nav-dropdown nav-dropdown-full"
                    @onclick="ToggleAccounts"
                    @onclick:stopPropagation="true"
                    aria-expanded="@accountsOpen"
                    aria-controls="accounts-submenu">
                <span class="nav-dropdown-label">Contas</span>
                <span class="nav-caret" aria-hidden="true">@(accountsOpen ? "▲" : "▼")</span>
            </button>

            <div id="accounts-submenu"
                 class="submenu-tree @(accountsOpen ? "is-open" : "is-collapsed")"
                 aria-hidden="@(!accountsOpen)">
                <div class="submenu-tree-inner">
                    <NavLink class="nav-sublink" href="/dashboard/accounts" @onclick="OnAccountsSubnavNavigate">
                        <span class="submenu-bullet" aria-hidden="true"></span>
                        Visão geral
                    </NavLink>
                </div>
            </div>
        </div>

        <div class="nav-group nav-group-gateways">
            <button type="button"
                    class="nav-dropdown nav-dropdown-full"
                    @onclick="TogglePayments"
                    @onclick:stopPropagation="true"
                    aria-expanded="@paymentsOpen"
                    aria-controls="payments-submenu">
                <span class="nav-dropdown-label">Pagamentos</span>
                <span class="nav-caret" aria-hidden="true">@(paymentsOpen ? "▲" : "▼")</span>
            </button>

            <div id="payments-submenu"
                 class="submenu-tree @(paymentsOpen ? "is-open" : "is-collapsed")"
                 aria-hidden="@(!paymentsOpen)">
                <div class="submenu-tree-inner">
                    <NavLink class="nav-sublink" href="/dashboard/payments" @onclick="OnPaymentsSubnavNavigate">
                        <span class="submenu-bullet" aria-hidden="true"></span>
                        Registros
                    </NavLink>
                    <NavLink class="nav-sublink" href="/dashboard/payments/pix" @onclick="OnPaymentsSubnavNavigate">
                        <span class="submenu-bullet" aria-hidden="true"></span>
                        Gerar PIX
                    </NavLink>
                </div>
            </div>
        </div>

        <div class="nav-group nav-group-gateways">
            <button type="button"
                    class="nav-dropdown nav-dropdown-full"
                    @onclick="ToggleGateways"
                    @onclick:stopPropagation="true"
                    aria-expanded="@gatewaysOpen"
                    aria-controls="gateway-submenu">
                <span class="nav-dropdown-label">Gateways</span>
                <span class="nav-caret" aria-hidden="true">@(gatewaysOpen ? "▲" : "▼")</span>
            </button>

            <div id="gateway-submenu"
                 class="submenu-tree @(gatewaysOpen ? "is-open" : "is-collapsed")"
                 aria-hidden="@(!gatewaysOpen)">
                <div class="submenu-tree-inner">
                    <NavLink class="nav-sublink" href="/dashboard/gateways" @onclick="OnGatewaysSubnavNavigate">
                        <span class="submenu-bullet" aria-hidden="true"></span>
                        Visão geral
                    </NavLink>
                    <NavLink class="nav-sublink" href="/dashboard/gateways/frendz" @onclick="OnGatewaysSubnavNavigate">
                        <span class="submenu-bullet" aria-hidden="true"></span>
                        Frendz
                    </NavLink>
                    <NavLink class="nav-sublink" href="/dashboard/gateways/sigilopay" @onclick="OnGatewaysSubnavNavigate">
                        <span class="submenu-bullet" aria-hidden="true"></span>
                        SigiloPay
                    </NavLink>
                    <NavLink class="nav-sublink" href="/dashboard/gateways/wintech" @onclick="OnGatewaysSubnavNavigate">
                        <span class="submenu-bullet" aria-hidden="true"></span>
                        Wintech
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool accountsOpen = true;
    private bool paymentsOpen = true;
    private bool gatewaysOpen = true;

    private void ToggleAccounts()
    {
        accountsOpen = !accountsOpen;
    }

    private void TogglePayments()
    {
        paymentsOpen = !paymentsOpen;
    }

    private void ToggleGateways()
    {
        gatewaysOpen = !gatewaysOpen;
    }

    private void OnAccountsSubnavNavigate()
    {
        accountsOpen = true;
    }

    private void OnPaymentsSubnavNavigate()
    {
        paymentsOpen = true;
    }

    private void OnGatewaysSubnavNavigate()
    {
        gatewaysOpen = true;
    }
}
