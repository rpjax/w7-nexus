@page "/dashboard/gateways/sigilopay"
@layout MainLayout
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http

<section class="page-header">
    <h1>SigiloPay</h1>
    <p class="muted page-lead">Credenciais com chave pública e secreta mascaradas; opcionalmente vincule um laranja (conta).</p>
</section>

@if (!string.IsNullOrWhiteSpace(feedback))
{
    <p class="feedback @(feedbackIsError ? "error" : "success")">@feedback</p>
}

<section class="card ops-card">
    <div class="card-title-row">
        <h2>Adicionar credencial</h2>
        <span class="post-badge">POST /api/sigilopay/credentials</span>
    </div>
    <div class="form-grid">
        <div class="field">
            <label for="spCredName">Nome</label>
            <input id="spCredName" class="nexus-input" @bind="addModel.Name" @bind:event="oninput" placeholder="Ex.: produção loja A" />
        </div>
        <div class="field">
            <label for="spPublicKey">Chave pública</label>
            <input id="spPublicKey" class="nexus-input" type="password" @bind="addModel.PublicKey" @bind:event="oninput" placeholder="x-public-key" />
        </div>
        <div class="field">
            <label for="spSecretKey">Chave secreta</label>
            <input id="spSecretKey" class="nexus-input" type="password" @bind="addModel.SecretKey" @bind:event="oninput" placeholder="x-secret-key" />
        </div>
        <div class="field span-2">
            <label class="checkbox-field">
                <input type="checkbox" @bind="addModel.Enabled" />
                <span>Habilitada para cobrança</span>
            </label>
            <p class="muted small" style="margin: 0.25rem 0 0 1.5rem;">Desmarque para manter a credencial cadastrada sem usar no orquestrador.</p>
        </div>
        <div class="field span-2">
            <label>Laranja (conta) <span class="muted small">opcional</span></label>
            <div class="account-select-row">
                <button type="button" class="account-select-trigger" @onclick="() => addStrawPickerOpen = true">
                    @(addStrawLabel ?? "Genérico (sem laranja)")
                </button>
                <button type="button" class="btn-icon btn-icon-warm" @onclick="() => addStrawPickerOpen = true" title="Selecionar laranja">＋</button>
                @if (addModel.StrawManId is not null)
                {
                    <button type="button" class="btn btn-ghost btn-small" @onclick="ClearAddStraw">Limpar</button>
                }
            </div>
        </div>
    </div>
    <div class="card-actions">
        <button type="button" class="btn btn-primary" @onclick="AddAsync" disabled="@addBusy">Adicionar</button>
    </div>
</section>

<section class="card ops-card">
    <div class="toolbar toolbar-tight">
        <div class="field grow">
            <label for="spCredSearch">Buscar credenciais</label>
            <input id="spCredSearch" class="nexus-input" @bind="search" @bind:event="oninput" placeholder="Nome, ID ou chaves…" />
        </div>
        <button type="button" class="btn btn-ghost" @onclick="SearchAsync">Buscar</button>
        <button type="button" class="btn btn-ghost" @onclick="RefreshAsync">Atualizar</button>
    </div>

    <h2 class="section-title">Credenciais cadastradas</h2>

    @if (filteredCredentials.Count == 0)
    {
        <EmptyState Title="Nenhuma credencial encontrada" Message="Cadastre uma credencial acima ou ajuste a busca." />
    }
    else
    {
        <div class="table-wrap table-top-gap">
            <table class="responsive-data ops-table">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Chave pública</th>
                        <th>Chave secreta</th>
                        <th>Laranja</th>
                        <th>Ativa</th>
                        <th class="th-actions" scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cred in filteredCredentials)
                    {
                        <tr>
                            <td data-label="Nome">@cred.Name</td>
                            <td data-label="Chave pública"><span class="mono token-mask" title="Mascarado">@MaskKey(cred.PublicKey)</span></td>
                            <td data-label="Chave secreta"><span class="mono token-mask" title="Mascarado">@MaskKey(cred.SecretKey)</span></td>
                            <td data-label="Laranja" class="muted">@FormatStraw(cred.StrawManId)</td>
                            <td data-label="Ativa">
                                <label class="toggle-inline">
                                    <input type="checkbox"
                                           checked="@cred.Enabled"
                                           disabled="@(enableToggleBusyId == cred.Id)"
                                           @onchange="e => OnEnabledToggledAsync(cred, e)" />
                                    <span class="muted small">@(cred.Enabled ? "Sim" : "Não")</span>
                                </label>
                            </td>
                            <td class="cell-actions" data-label="Ações">
                                <div class="row-actions">
                                    <button type="button"
                                            class="icon-action"
                                            title="Ver chaves"
                                            aria-label="Ver credencial"
                                            @onclick="() => ViewAsync(cred)">
                                        👁
                                    </button>
                                    <button type="button"
                                            class="icon-action"
                                            title="Editar"
                                            aria-label="Editar credencial"
                                            @onclick="() => BeginEditAsync(cred)">
                                        ✎
                                    </button>
                                    <button type="button"
                                            class="icon-action icon-action-danger"
                                            title="Excluir"
                                            aria-label="Excluir credencial"
                                            @onclick="() => BeginDeleteAsync(cred.Id)">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (editing is not null)
{
    <div class="dialog-backdrop dialog-backdrop--modal" @onclick="CancelEditAsync">
        <div class="dialog-card dialog-card--wide" @onclick:stopPropagation="true">
            <div class="modal-stack">
                <div class="modal-stack-header">
                    <div>
                        <h2 class="manage-ids-title">Editar credencial SigiloPay</h2>
                        <p class="muted small">PUT /api/sigilopay/credentials</p>
                    </div>
                    <button type="button" class="btn btn-ghost btn-small" @onclick="CancelEditAsync">Fechar</button>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label for="spEditCredName">Nome</label>
                        <input id="spEditCredName" class="nexus-input" @bind="editing.Name" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="spEditPublicKey">Chave pública</label>
                        <input id="spEditPublicKey" class="nexus-input" type="password" @bind="editing.PublicKey" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="spEditSecretKey">Chave secreta</label>
                        <input id="spEditSecretKey" class="nexus-input" type="password" @bind="editing.SecretKey" @bind:event="oninput" />
                    </div>
                    <div class="field span-2">
                        <label>Laranja (conta)</label>
                        <div class="account-select-row">
                            <button type="button" class="account-select-trigger" @onclick="() => editStrawPickerOpen = true">
                                @(EditStrawLabel ?? "Genérico (sem laranja)")
                            </button>
                            <button type="button" class="btn-icon btn-icon-warm" @onclick="() => editStrawPickerOpen = true" title="Selecionar laranja">＋</button>
                            @if (editing.StrawManId is not null)
                            {
                                <button type="button" class="btn btn-ghost btn-small" @onclick="ClearEditStraw">Limpar</button>
                            }
                        </div>
                    </div>
                    <div class="field span-2">
                        <label class="checkbox-field">
                            <input type="checkbox" @bind="editing.Enabled" />
                            <span>Habilitada para cobrança</span>
                        </label>
                    </div>
                </div>
                <div class="modal-stack-footer">
                    <button type="button" class="btn btn-primary" @onclick="UpdateAsync" disabled="@editBusy">Salvar</button>
                    <button type="button" class="btn btn-ghost" @onclick="CancelEditAsync">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

<AccountPickerModal @bind-IsOpen="addStrawPickerOpen"
                    Title="Laranja para credencial"
                    Subtitle="Opcional. Credenciais sem laranja participam como genéricas no filtro de cobrança."
                    OnSelected="OnAddStrawPicked" />

<AccountPickerModal @bind-IsOpen="editStrawPickerOpen"
                    Title="Laranja para credencial"
                    Subtitle="Vincule uma conta ou deixe genérico."
                    OnSelected="OnEditStrawPicked" />

<ConfirmDialog IsOpen="@deleteDialogOpen"
                Title="Confirmar exclusão"
                Message="Tem certeza que deseja excluir esta credencial SigiloPay?"
                OnCancel="CancelDeleteAsync"
                OnConfirm="ConfirmDeleteAsync" />

@if (viewingCredential is not null)
{
    <div class="dialog-backdrop dialog-backdrop--modal" @onclick="CloseViewAsync">
        <div class="dialog-card dialog-card--wide" @onclick:stopPropagation="true">
            <div class="modal-stack">
                <div class="modal-stack-header">
                    <h2 class="manage-ids-title">Credencial SigiloPay</h2>
                    <button type="button" class="btn btn-ghost btn-small" @onclick="CloseViewAsync">Fechar</button>
                </div>
                <p class="muted stack-tight"><strong>ID:</strong> <span class="mono">@viewingCredential.Id</span></p>
                <p class="muted stack-tight"><strong>Nome:</strong> @viewingCredential.Name</p>
                <p class="muted stack-tight"><strong>Cobrança:</strong> @(viewingCredential.Enabled ? "Habilitada" : "Desabilitada")</p>
                <div class="field">
                    <label>Chave pública</label>
                    <textarea readonly rows="3" class="nexus-input">@viewingCredential.PublicKey</textarea>
                </div>
                <div class="field">
                    <label>Chave secreta</label>
                    <textarea readonly rows="3" class="nexus-input">@viewingCredential.SecretKey</textarea>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);

    private class CredentialVm
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string PublicKey { get; set; } = string.Empty;
        public string SecretKey { get; set; } = string.Empty;
        public string? StrawManId { get; set; }
        public bool Enabled { get; set; } = true;
    }

    private sealed class EditCredentialVm : CredentialVm
    {
    }

    private sealed class SearchResponse<TItem>
    {
        public int Total { get; set; }
        public List<TItem> Items { get; set; } = new();
    }

    private readonly CredentialVm addModel = new();
    private string search = string.Empty;

    private List<CredentialVm> credentials = new();
    private IReadOnlyList<CredentialVm> filteredCredentials = Array.Empty<CredentialVm>();

    private EditCredentialVm? editing;
    private string? addStrawLabel;
    private string? EditStrawLabel => editing is null
        ? null
        : (editing.StrawManId is null
            ? null
            : (accountLabels.TryGetValue(editing.StrawManId, out var u) ? $"{u} ({editing.StrawManId})" : editing.StrawManId));

    private bool addStrawPickerOpen;
    private bool editStrawPickerOpen;
    private bool addBusy;
    private bool editBusy;

    private readonly Dictionary<string, string> accountLabels = new(StringComparer.Ordinal);

    private bool deleteDialogOpen;
    private string deleteId = string.Empty;

    private CredentialVm? viewingCredential;

    private string feedback = string.Empty;
    private bool feedbackIsError;
    private string? enableToggleBusyId;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        feedbackIsError = false;
        feedback = string.Empty;

        var response = await Http.PostAsJsonAsync("/api/sigilopay/search", new
        {
            Limit = 999,
            Offset = 0,
            Keyword = (string?)null
        });
        if (!response.IsSuccessStatusCode)
        {
            feedbackIsError = true;
            feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao carregar credenciais.");
            return;
        }

        var items = await response.Content.ReadFromJsonAsync<SearchResponse<CredentialVm>>(_jsonOptions);
        credentials = (items?.Items ?? new List<CredentialVm>())
            .OrderBy(c => c.Name)
            .ToList();
        foreach (var c in credentials.Where(c => c.StrawManId is not null))
            accountLabels.TryAdd(c.StrawManId!, ShortId(c.StrawManId!));
        ApplyFilter();
    }

    private static string ShortId(string id)
        => id.Length <= 16 ? id : id[..12] + "…";

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            filteredCredentials = credentials;
            return;
        }

        var term = search.Trim().ToLowerInvariant();
        filteredCredentials = credentials
            .Where(c =>
                c.Name.ToLowerInvariant().Contains(term) ||
                c.Id.ToLowerInvariant().Contains(term) ||
                c.PublicKey.ToLowerInvariant().Contains(term) ||
                c.SecretKey.ToLowerInvariant().Contains(term) ||
                (c.StrawManId != null && c.StrawManId.ToLowerInvariant().Contains(term)))
            .ToList();
    }

    private Task SearchAsync()
    {
        ApplyFilter();
        return Task.CompletedTask;
    }

    private Task OnAddStrawPicked(AccountPickerModal.AccountPickerRow row)
    {
        addModel.StrawManId = row.Id;
        addStrawLabel = $"{row.Username} ({row.Id})";
        accountLabels[row.Id] = row.Username;
        return Task.CompletedTask;
    }

    private Task OnEditStrawPicked(AccountPickerModal.AccountPickerRow row)
    {
        if (editing is null)
            return Task.CompletedTask;
        editing.StrawManId = row.Id;
        accountLabels[row.Id] = row.Username;
        return Task.CompletedTask;
    }

    private void ClearAddStraw()
    {
        addModel.StrawManId = null;
        addStrawLabel = null;
    }

    private void ClearEditStraw()
    {
        if (editing is null)
            return;
        editing.StrawManId = null;
    }

    private string FormatStraw(string? strawManId)
    {
        if (string.IsNullOrWhiteSpace(strawManId))
            return "— genérico";
        return accountLabels.TryGetValue(strawManId, out var u) ? $"{u}" : strawManId;
    }

    private async Task AddAsync()
    {
        addBusy = true;
        feedback = string.Empty;
        feedbackIsError = false;
        try
        {
            if (string.IsNullOrWhiteSpace(addModel.PublicKey) || string.IsNullOrWhiteSpace(addModel.SecretKey))
            {
                feedbackIsError = true;
                feedback = "Chave pública e chave secreta são obrigatórias.";
                return;
            }

            var response = await Http.PostAsJsonAsync("/api/sigilopay/credentials", new
            {
                Name = addModel.Name,
                PublicKey = addModel.PublicKey,
                SecretKey = addModel.SecretKey,
                StrawManId = addModel.StrawManId,
                Enabled = addModel.Enabled
            });

            if (!response.IsSuccessStatusCode)
            {
                feedbackIsError = true;
                feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao adicionar credencial.");
                return;
            }

            feedback = "Credencial adicionada com sucesso.";
            addModel.Name = string.Empty;
            addModel.PublicKey = string.Empty;
            addModel.SecretKey = string.Empty;
            addModel.StrawManId = null;
            addModel.Enabled = true;
            addStrawLabel = null;
            await RefreshAsync();
        }
        finally
        {
            addBusy = false;
        }
    }

    private static string MaskKey(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return string.Empty;

        if (key.Length <= 10)
            return new string('*', key.Length);

        return $"{key[..4]}…{key[^4..]}";
    }

    private void ViewAsync(CredentialVm cred)
    {
        viewingCredential = cred;
    }

    private Task CloseViewAsync()
    {
        viewingCredential = null;
        return Task.CompletedTask;
    }

    private async Task OnEnabledToggledAsync(CredentialVm cred, ChangeEventArgs e)
    {
        var newEnabled = e.Value is bool b && b;
        enableToggleBusyId = cred.Id;
        StateHasChanged();
        try
        {
            var response = await Http.PatchAsJsonAsync("/api/sigilopay/credentials/enabled", new { id = cred.Id, enabled = newEnabled });
            if (!response.IsSuccessStatusCode)
            {
                feedbackIsError = true;
                feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao atualizar estado da credencial.");
                await RefreshAsync();
                return;
            }

            cred.Enabled = newEnabled;
            feedbackIsError = false;
            feedback = newEnabled ? "Credencial habilitada para cobrança." : "Credencial desabilitada (não entra no orquestrador).";
        }
        finally
        {
            enableToggleBusyId = null;
            StateHasChanged();
        }
    }

    private void BeginEditAsync(CredentialVm cred)
    {
        editing = new EditCredentialVm
        {
            Id = cred.Id,
            Name = cred.Name,
            PublicKey = cred.PublicKey,
            SecretKey = cred.SecretKey,
            StrawManId = cred.StrawManId,
            Enabled = cred.Enabled
        };
        if (cred.StrawManId is not null)
            accountLabels.TryAdd(cred.StrawManId, ShortId(cred.StrawManId));
        feedback = string.Empty;
        feedbackIsError = false;
    }

    private Task CancelEditAsync()
    {
        editing = null;
        return Task.CompletedTask;
    }

    private async Task UpdateAsync()
    {
        if (editing is null)
            return;

        editBusy = true;
        feedback = string.Empty;
        feedbackIsError = false;
        try
        {
            if (string.IsNullOrWhiteSpace(editing.PublicKey) || string.IsNullOrWhiteSpace(editing.SecretKey))
            {
                feedbackIsError = true;
                feedback = "Chave pública e chave secreta são obrigatórias.";
                return;
            }

            var response = await Http.PutAsJsonAsync("/api/sigilopay/credentials", new
            {
                Id = editing.Id,
                StrawManId = editing.StrawManId,
                PublicKey = editing.PublicKey,
                SecretKey = editing.SecretKey,
                Name = editing.Name,
                Enabled = editing.Enabled
            });

            if (!response.IsSuccessStatusCode)
            {
                feedbackIsError = true;
                feedback = await DashboardApiErrors.ReadMessageAsync(response, "Falha ao atualizar credencial.");
                return;
            }

            feedback = "Credencial atualizada com sucesso.";
            editing = null;
            await RefreshAsync();
        }
        finally
        {
            editBusy = false;
        }
    }

    private Task BeginDeleteAsync(string id)
    {
        deleteId = id;
        deleteDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task CancelDeleteAsync()
    {
        deleteDialogOpen = false;
        deleteId = string.Empty;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        deleteDialogOpen = false;
        if (string.IsNullOrWhiteSpace(deleteId))
            return;

        feedbackIsError = false;
        feedback = string.Empty;

        try
        {
            var response = await Http.DeleteAsync($"/api/sigilopay/credentials?id={Uri.EscapeDataString(deleteId)}");
            feedbackIsError = !response.IsSuccessStatusCode;
            feedback = response.IsSuccessStatusCode
                ? "Credencial excluída com sucesso."
                : await DashboardApiErrors.ReadMessageAsync(response, "Falha ao excluir credencial.");
            deleteId = string.Empty;
            editing = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            feedbackIsError = true;
            feedback = ex.Message;
        }
    }
}
